--[[
    LIB-PHILANX UI Library with Integrated Key System
    Version: 1.0.0
]]

local PhilanxUI = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local Theme = {
    Background = Color3.fromRGB(13, 17, 23),
    Secondary = Color3.fromRGB(22, 27, 34),
    Tertiary = Color3.fromRGB(33, 38, 45),
    Accent = Color3.fromRGB(35, 155, 255),
    Text = Color3.fromRGB(240, 246, 252),
    SubText = Color3.fromRGB(139, 148, 158),
    Border = Color3.fromRGB(48, 54, 61),
    Success = Color3.fromRGB(46, 160, 67),
    Error = Color3.fromRGB(248, 81, 73)
}

local function Create(cls, props)
    local obj = Instance.new(cls)
    for k, v in pairs(props or {}) do obj[k] = v end
    return obj
end

local function AddCorner(p, r)
    return Create("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = p })
end

local function AddStroke(p, col)
    return Create("UIStroke", { Color = col or Theme.Border, Thickness = 1, Parent = p })
end

function PhilanxUI:KeySystem(options)
    options = options or {}
    local correctKey = options.CorrectKey or "PHILANX2026"
    local keyLink = options.KeyLink or "https://discord.gg/philanx"

    pcall(function()
        if readfile and isfile and isfile("PhilanxKey.txt") and readfile("PhilanxKey.txt") == correctKey then
            if options.Callback then options.Callback() end
            return
        end
    end)

    local ScreenGui = Create("ScreenGui", { Name = "PhilanxKey", Parent = CoreGui, ResetOnSpawn = false })
    local Main = Create("Frame", {
        Parent = ScreenGui, AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Background, Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 380, 0, 200), BorderSizePixel = 0
    })
    AddCorner(Main, 10) AddStroke(Main, Theme.Border)

    local Top = Create("Frame", { Parent = Main, BackgroundColor3 = Theme.Secondary, Size = UDim2.new(1, 0, 0, 38) })
    AddCorner(Top, 10)
    Create("TextLabel", {
        Parent = Top, BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 0),
        Size = UDim2.new(1, -30, 1, 0), Font = Enum.Font.GothamBold,
        Text = options.Title or "Philanx Hub - Key System", TextColor3 = Theme.Text, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local BoxBg = Create("Frame", {
        Parent = Main, BackgroundColor3 = Theme.Secondary,
        Position = UDim2.new(0, 20, 0, 55), Size = UDim2.new(1, -40, 0, 36)
    })
    AddCorner(BoxBg, 6) AddStroke(BoxBg, Theme.Border)

    local Input = Create("TextBox", {
        Parent = BoxBg, BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -20, 1, 0), Font = Enum.Font.Gotham,
        PlaceholderText = "Masukkan Key Valid...", PlaceholderColor3 = Theme.SubText,
        Text = "", TextColor3 = Theme.Text, TextSize = 13
    })

    local Verify = Create("TextButton", {
        Parent = Main, BackgroundColor3 = Theme.Accent,
        Position = UDim2.new(0, 20, 0, 110), Size = UDim2.new(0.5, -25, 0, 36),
        AutoButtonColor = false, Font = Enum.Font.GothamBold,
        Text = "Verifikasi Key", TextColor3 = Color3.new(1, 1, 1), TextSize = 13
    })
    AddCorner(Verify, 6)

    local GetKey = Create("TextButton", {
        Parent = Main, BackgroundColor3 = Theme.Tertiary,
        Position = UDim2.new(0.5, 5, 0, 110), Size = UDim2.new(0.5, -25, 0, 36),
        AutoButtonColor = false, Font = Enum.Font.GothamBold,
        Text = "Dapatkan Key", TextColor3 = Theme.Text, TextSize = 13
    })
    AddCorner(GetKey, 6) AddStroke(GetKey, Theme.Border)

    GetKey.MouseButton1Click:Connect(function()
        pcall(function() setclipboard(keyLink) end)
        GetKey.Text = "Link Disalin!"
        task.wait(1.5)
        GetKey.Text = "Dapatkan Key"
    end)

    Verify.MouseButton1Click:Connect(function()
        if Input.Text == correctKey then
            Verify.BackgroundColor3 = Theme.Success
            Verify.Text = "Key Benar!"
            pcall(function() if writefile then writefile("PhilanxKey.txt", correctKey) end end)
            task.wait(0.5)
            ScreenGui:Destroy()
            if options.Callback then options.Callback() end
        else
            Verify.BackgroundColor3 = Theme.Error
            Verify.Text = "Key Salah!"
            task.wait(1)
            Verify.BackgroundColor3 = Theme.Accent
            Verify.Text = "Verifikasi Key"
        end
    end)
end

function PhilanxUI:CreateWindow(options)
    options = options or {}
    local ScreenGui = Create("ScreenGui", { Name = "PhilanxWindow", Parent = CoreGui, ResetOnSpawn = false })
    local Main = Create("Frame", {
        Parent = ScreenGui, AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Theme.Background, Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 500, 0, 340), BorderSizePixel = 0
    })
    AddCorner(Main, 10) AddStroke(Main, Theme.Border)

    local Top = Create("Frame", { Parent = Main, BackgroundColor3 = Theme.Secondary, Size = UDim2.new(1, 0, 0, 40) })
    AddCorner(Top, 10)
    Create("TextLabel", {
        Parent = Top, BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 0),
        Size = UDim2.new(1, -90, 1, 0), Font = Enum.Font.GothamBold,
        Text = (options.Icon or "⚡ ") .. (options.Title or "Philanx Hub"), TextColor3 = Theme.Text, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    -- Close Button (X)
    local CloseBtn = Create("TextButton", {
        Parent = Top, BackgroundColor3 = Color3.fromRGB(235, 85, 85),
        Position = UDim2.new(1, -32, 0.5, -12), Size = UDim2.new(0, 24, 0, 24),
        AutoButtonColor = false, Font = Enum.Font.GothamBold, Text = "✕", TextColor3 = Color3.new(1, 1, 1), TextSize = 11
    })
    AddCorner(CloseBtn, 6)
    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    -- Minimize Button (-)
    local minimized = false
    local Container = Create("Frame", {
        Parent = Main, BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 50), Size = UDim2.new(1, -20, 1, -60)
    })

    local MinBtn = Create("TextButton", {
        Parent = Top, BackgroundColor3 = Theme.Tertiary,
        Position = UDim2.new(1, -62, 0.5, -12), Size = UDim2.new(0, 24, 0, 24),
        AutoButtonColor = false, Font = Enum.Font.GothamBold, Text = "—", TextColor3 = Theme.Text, TextSize = 11
    })
    AddCorner(MinBtn, 6) AddStroke(MinBtn, Theme.Border)

    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        Container.Visible = not minimized
        TweenService:Create(Main, TweenInfo.new(0.2), {Size = minimized and UDim2.new(0, 500, 0, 40) or UDim2.new(0, 500, 0, 340)}):Play()
    end)

    local Sidebar = Create("ScrollingFrame", {
        Parent = Container, BackgroundTransparency = 1,
        Size = UDim2.new(0, 120, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarThickness = 2
    })
    Create("UIListLayout", { Parent = Sidebar, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5) })

    local Pages = Create("Frame", {
        Parent = Container, BackgroundTransparency = 1,
        Position = UDim2.new(0, 140, 0, 0), Size = UDim2.new(1, -150, 1, 0)
    })

    local WindowObj = {}
    local first = true

    function WindowObj:CreateTab(tabOpts)
        local tabName = type(tabOpts) == "table" and tabOpts.Name or tabOpts
        local tabIcon = type(tabOpts) == "table" and tabOpts.Icon or "📁"

        local TabBtn = Create("TextButton", {
            Parent = Sidebar, BackgroundColor3 = Theme.Secondary,
            Size = UDim2.new(1, 0, 0, 32), AutoButtonColor = false,
            Font = Enum.Font.GothamMedium, Text = "  " .. tabIcon .. "  " .. tabName,
            TextColor3 = Theme.SubText, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left
        })
        AddCorner(TabBtn, 6)

        local Page = Create("ScrollingFrame", {
            Parent = Pages, BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0), CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 2, Visible = false
        })
        Create("UIListLayout", { Parent = Page, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) })

        if first then
            first = false
            Page.Visible = true
            TabBtn.TextColor3 = Theme.Text
            TabBtn.BackgroundColor3 = Theme.Tertiary
        end

        TabBtn.MouseButton1Click:Connect(function()
            for _, p in pairs(Pages:GetChildren()) do if p:IsA("ScrollingFrame") then p.Visible = false end end
            for _, b in pairs(Sidebar:GetChildren()) do
                if b:IsA("TextButton") then b.TextColor3 = Theme.SubText b.BackgroundColor3 = Theme.Secondary end
            end
            Page.Visible = true
            TabBtn.TextColor3 = Theme.Text
            TabBtn.BackgroundColor3 = Theme.Tertiary
        end)

        local TabObj = {}
        function TabObj:CreateButton(opts, cb)
            local name = type(opts) == "table" and opts.Name or opts
            local icon = type(opts) == "table" and opts.Icon or "🔘"

            local Btn = Create("TextButton", {
                Parent = Page, BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 34), AutoButtonColor = false,
                Font = Enum.Font.GothamMedium, Text = "  " .. icon .. "  " .. name,
                TextColor3 = Theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left
            })
            AddCorner(Btn, 6) AddStroke(Btn, Theme.Border)
            Btn.MouseButton1Click:Connect(function() if cb then pcall(cb) end end)
        end

        function TabObj:CreateToggle(opts, default, cb)
            local name = type(opts) == "table" and opts.Name or opts
            local icon = type(opts) == "table" and opts.Icon or "☑️"
            local toggled = default or false

            local Tgl = Create("TextButton", {
                Parent = Page, BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 34), AutoButtonColor = false, Text = ""
            })
            AddCorner(Tgl, 6) AddStroke(Tgl, Theme.Border)

            Create("TextLabel", {
                Parent = Tgl, BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -60, 1, 0), Font = Enum.Font.GothamMedium,
                Text = icon .. "  " .. name, TextColor3 = Theme.Text, TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            local ToggleBox = Create("Frame", {
                Parent = Tgl, AnchorPoint = Vector2.new(1, 0.5),
                BackgroundColor3 = toggled and Theme.Accent or Theme.Tertiary,
                Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 36, 0, 20)
            })
            AddCorner(ToggleBox, 10)

            local Circle = Create("Frame", {
                Parent = ToggleBox, BackgroundColor3 = Color3.new(1, 1, 1),
                Position = toggled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
                Size = UDim2.new(0, 16, 0, 16)
            })
            AddCorner(Circle, 8)

            Tgl.MouseButton1Click:Connect(function()
                toggled = not toggled
                TweenService:Create(ToggleBox, TweenInfo.new(0.2), {BackgroundColor3 = toggled and Theme.Accent or Theme.Tertiary}):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {Position = toggled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
                if cb then pcall(cb, toggled) end
            end)
        end
        function TabObj:CreateSlider(opts, min, max, default, cb)
            local name = type(opts) == "table" and opts.Name or opts
            local icon = type(opts) == "table" and opts.Icon or "🎚️"
            min = type(opts) == "table" and opts.Min or min or 0
            max = type(opts) == "table" and opts.Max or max or 100
            default = type(opts) == "table" and opts.Default or default or min

            local SliderFrame = Create("Frame", {
                Parent = Page, BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 52)
            })
            AddCorner(SliderFrame, 6) AddStroke(SliderFrame, Theme.Border)

            Create("TextLabel", {
                Parent = SliderFrame, BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 20),
                Font = Enum.Font.GothamMedium, Text = icon .. "  " .. name,
                TextColor3 = Theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left
            })

            local ValLabel = Create("TextLabel", {
                Parent = SliderFrame, BackgroundTransparency = 1,
                Position = UDim2.new(1, -60, 0, 6), Size = UDim2.new(0, 48, 0, 20),
                Font = Enum.Font.GothamBold, Text = tostring(default),
                TextColor3 = Theme.SubText, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right
            })

            local Bar = Create("Frame", {
                Parent = SliderFrame, BackgroundColor3 = Theme.Tertiary,
                Position = UDim2.new(0, 12, 0, 35), Size = UDim2.new(1, -24, 0, 6)
            })
            AddCorner(Bar, 3)

            local Fill = Create("Frame", {
                Parent = Bar, BackgroundColor3 = Theme.Accent,
                Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            })
            AddCorner(Fill, 3)

            local dragging = false
            Bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local mousePos = UserInputService:GetMouseLocation().X
                    local barPos = Bar.AbsolutePosition.X
                    local barSize = Bar.AbsoluteSize.X
                    local pos = math.clamp((mousePos - barPos) / barSize, 0, 1)
                    local val = math.floor(min + ((max - min) * pos))
                    Fill.Size = UDim2.new(pos, 0, 1, 0)
                    ValLabel.Text = tostring(val)
                    if cb then pcall(cb, val) end
                end
            end)
        end

        function TabObj:CreateDropdown(opts, list, cb)
            local name = type(opts) == "table" and opts.Name or opts
            local icon = type(opts) == "table" and opts.Icon or "📂"
            list = type(opts) == "table" and opts.List or list or {}

            local open = false
            local DropFrame = Create("Frame", {
                Parent = Page, BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 36), ClipsDescendants = true
            })
            AddCorner(DropFrame, 6) AddStroke(DropFrame, Theme.Border)

            local DropBtn = Create("TextButton", {
                Parent = DropFrame, BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 36), AutoButtonColor = false,
                Font = Enum.Font.GothamMedium, Text = icon .. "  " .. name,
                TextColor3 = Theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left
            })

            local Arrow = Create("TextLabel", {
                Parent = DropBtn, BackgroundTransparency = 1,
                Position = UDim2.new(1, -30, 0, 0), Size = UDim2.new(0, 20, 1, 0),
                Font = Enum.Font.GothamBold, Text = "▼", TextColor3 = Theme.SubText, TextSize = 10
            })

            local ItemHolder = Create("Frame", {
                Parent = DropFrame, BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 38), Size = UDim2.new(1, 0, 1, -38)
            })
            Create("UIListLayout", { Parent = ItemHolder, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) })

            for _, item in ipairs(list) do
                local ItemBtn = Create("TextButton", {
                    Parent = ItemHolder, BackgroundColor3 = Theme.Tertiary,
                    Size = UDim2.new(1, 0, 0, 30), AutoButtonColor = false,
                    Font = Enum.Font.Gotham, Text = "    " .. tostring(item),
                    TextColor3 = Theme.SubText, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left
                })
                AddCorner(ItemBtn, 4)
                ItemBtn.MouseButton1Click:Connect(function()
                    open = false
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 36)}):Play()
                    Arrow.Text = "▼"
                    if cb then pcall(cb, item) end
                end)
            end

            DropBtn.MouseButton1Click:Connect(function()
                open = not open
                local targetHeight = open and (36 + (#list * 32) + 6) or 36
                TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
                Arrow.Text = open and "▲" or "▼"
            end)
        end

        function TabObj:CreateInput(opts, cb)
            local name = type(opts) == "table" and opts.Name or opts
            local icon = type(opts) == "table" and opts.Icon or "⌨️"
            local placeholder = type(opts) == "table" and opts.Placeholder or "Ketik di sini..."

            local InputFrame = Create("Frame", {
                Parent = Page, BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 56)
            })
            AddCorner(InputFrame, 6) AddStroke(InputFrame, Theme.Border)

            Create("TextLabel", {
                Parent = InputFrame, BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 20),
                Font = Enum.Font.GothamMedium, Text = icon .. "  " .. name,
                TextColor3 = Theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left
            })

            local BoxBg = Create("Frame", {
                Parent = InputFrame, BackgroundColor3 = Theme.Tertiary,
                Position = UDim2.new(0, 12, 0, 28), Size = UDim2.new(1, -24, 0, 22)
            })
            AddCorner(BoxBg, 4)

            local TextBox = Create("TextBox", {
                Parent = BoxBg, BackgroundTransparency = 1,
                Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -16, 1, 0),
                Font = Enum.Font.Gotham, PlaceholderText = placeholder,
                PlaceholderColor3 = Theme.SubText, Text = "",
                TextColor3 = Theme.Text, TextSize = 11, ClearTextOnFocus = false
            })

            TextBox.FocusLost:Connect(function(enterPressed)
                if cb then pcall(cb, TextBox.Text, enterPressed) end
            end)
        end
        function TabObj:CreateParagraph(opts)
            local title = type(opts) == "table" and opts.Title or "Info"
            local desc = type(opts) == "table" and opts.Desc or opts

            local Para = Create("Frame", {
                Parent = Page, BackgroundColor3 = Theme.Secondary,
                Size = UDim2.new(1, 0, 0, 60)
            })
            AddCorner(Para, 6) AddStroke(Para, Theme.Border)

            Create("TextLabel", {
                Parent = Para, BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 8), Size = UDim2.new(1, -24, 0, 18),
                Font = Enum.Font.GothamBold, Text = title, TextColor3 = Theme.Text, TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            Create("TextLabel", {
                Parent = Para, BackgroundTransparency = 1,
                Position = UDim2.new(0, 12, 0, 28), Size = UDim2.new(1, -24, 0, 24),
                Font = Enum.Font.Gotham, Text = desc, TextColor3 = Theme.SubText, TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true
            })
        end
        return TabObj
    end

    return WindowObj
end

return PhilanxUI
